# Copy this file to .env and fill in your values.
# On Railway, set these as environment variables in the service dashboard.

# ── Required ──────────────────────────────────────────────────────────────────

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MongoDB connection string (Atlas free tier works)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ── Optional ──────────────────────────────────────────────────────────────────

# MongoDB database name (default: icai_bot)
MONGODB_DB=icai_bot

# Telegram chat ID of the bot admin — receives heartbeat failure alerts
ADMIN_CHAT_ID=123456789

# ── Email notifications ───────────────────────────────────────────────────────
# Required only if you want email alerts. Users can also set their own email
# via the /email command inside the bot.

# Gmail address used as sender
GMAIL_USER=yourname@gmail.com

# 16-char Gmail App Password (NOT your Gmail login password)
# Create at: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Fallback recipient for monitor.py standalone runs (optional)
ALERT_EMAIL=yourname@gmail.com
